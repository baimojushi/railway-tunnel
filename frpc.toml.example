# ============================================
# frpc 客户端配置模板 — Railway 内网穿透
# ============================================
# 部署前请将本文件复制为 frpc.toml 并修改:
#   serverAddr → 你的 Railway TCP 端点地址
#   serverPort → Railway 分配的 TCP 端口
#   auth.token → 与服务端一致的 token
# ============================================

serverAddr = "your-railway-app.railway.app"
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_TO_YOUR_SECRET_TOKEN"

# ---------- 隧道示例 ----------

## 示例 1: 映射本地 SSH (22) 到远程 2222
# [[proxies]]
# name = "ssh"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 22
# remotePort = 2222

## 示例 2: 映射本地 Web 服务 (3000) 到远程 8080
# [[proxies]]
# name = "web"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 3000
# remotePort = 8080

## 示例 3: 映射本地 RDP (3389) 到远程 33890
# [[proxies]]
# name = "rdp"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 3389
# remotePort = 33890

## 示例 4: 映射远程桌面 Web (8000) 到远程 8000
# [[proxies]]
# name = "api"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 8000
# remotePort = 8000
